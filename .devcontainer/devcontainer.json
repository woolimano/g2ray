{
  "name": "ghtun-3xui",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postStartCommand": "bash -lc '/app/auto-start-3xui.sh > /tmp/3x-ui-autostart.log 2>&1 || true'",
  "postAttachCommand": "bash -lc 'echo Panel: https://${CODESPACE_NAME}-2053.app.github.dev/panel/ && echo Logs: /tmp/3x-ui.log && tail -n 60 /tmp/3x-ui-autostart.log 2>/dev/null || true'",
  "portsAttributes": {
    "2053": {
      "label": "3x-ui panel",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    },
    "443": {
      "label": "xray-vless-xhttp",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    2053,
    443
  ],
  "hostRequirements": {
    "cpus": 2
  }
}